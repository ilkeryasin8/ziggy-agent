{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "disableAllHooks": true,
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git worktree:*)",
      "Bash(git config:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker:*)",
      "Bash(npm publish:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(sudo:*)",
      "Bash(launchctl:*)",
      "Bash(osascript:*)",
      "Read(./.env*)",
      "Read(**/.npmrc)",
      "Read(~/.config/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude.json)",
      "Read(~/Documents/**)",
      "Read(~/Desktop/**)",
      "Read(~/Downloads/**)",
      "Read(~/Library/Mobile Documents/**)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude-*/projects/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./AGENTS.md)",
      "WebFetch",
      "WebSearch"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(uv run:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(python -m pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": [],
      "allowLocalBinding": true
    }
  }
}
