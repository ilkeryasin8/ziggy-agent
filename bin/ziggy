#!/usr/bin/env python3
"""Entry point; runs from a checkout without installation."""
import sys

if sys.version_info < (3, 12):
    sys.exit(f"ziggy needs Python 3.12 or newer; this is {sys.version.split()[0]} ({sys.executable}). "
             "Run it with python3.12, or install it: pipx install .")

from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from ziggy.cli import main  # noqa: E402

sys.exit(main())
